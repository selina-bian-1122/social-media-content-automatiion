# Lark App
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Bitable IDs (from browser URL)
LARK_BASE_APP_TOKEN=xxxxxxx
LARK_TABLE_MATERIALS=tblxxxxxxx
LARK_TABLE_ACCOUNTS=tblxxxxxxx
LARK_TABLE_TOPICS=tblxxxxxxx
LARK_TABLE_CONTENT=tblxxxxxxx
LARK_TABLE_PUBLISH=tblxxxxxxx
LARK_TABLE_REPORT=tblxxxxxxx

# Lark Bot
LARK_BOT_CHAT_ID=oc_xxxxxxxxx
# 收消息方式：poll（默认，无需订阅事件）| ws（需订阅事件与卡片回调）
BOT_MODE=poll
# poll 模式监听的会话（逗号分隔），默认 = LARK_BOT_CHAT_ID
BOT_POLL_CHAT_IDS=
BOT_POLL_INTERVAL=5
# Bot 管理员白名单（邮箱和 open_id 都为空时 bot 进入绑定模式）
BOT_ADMIN_EMAILS=alice@orphlux.ai,bob@orphlux.ai
BOT_ADMIN_OPEN_IDS=
# 多维表格网页地址（可选），用于消息里的跳转链接
LARK_BASE_URL=https://xxx.larksuite.com/base/xxxxxxx

# AI API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx
# 使用第三方中转服务时，填服务商给的接口地址（留空=直连官方）
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# 自动发布（预留接口，默认关闭）：true 时把「已通过」的内容通过 X API 发布并改为「已发布」
# 需先实现 automations/publisher.py 中的 XApiPublisher
AUTO_PUBLISH=false

# RSS 抓取（可选）：每个源只看最新 N 条；只收最近 N 天内发布的文章
RSS_MAX_PER_FEED=5
RSS_MAX_AGE_DAYS=3
